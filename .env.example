# Tatum API key (dashboard.tatum.io). Without it the Sui gateway allows 5 requests a minute.
TATUM_API_KEY=
# Walrus Memory (memory.walrus.xyz, Mainnet): delegate private key and account object id.
MEMWAL_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_NAMESPACE=ticketwise
# Teammates type this to write to the team's memory. Visitors write to their own sandbox.
TEAM_PASSCODE=
